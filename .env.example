# Local development only. Copy to .env.local; change every password before reuse.
POSTGRES_USER=zemaitija_bootstrap
POSTGRES_PASSWORD=change-bootstrap-local
POSTGRES_DB=zemaitija_dev
APP_DB_USER=zemaitija_app
APP_DB_PASSWORD=change-app-local
MIGRATION_DB_USER=zemaitija_migrator
MIGRATION_DB_PASSWORD=change-migration-local
DATABASE_URL=postgresql://zemaitija_app:change-app-local@127.0.0.1:5432/zemaitija_dev
MIGRATION_DATABASE_URL=postgresql://zemaitija_migrator:change-migration-local@127.0.0.1:5432/zemaitija_dev
# Stripe test-mode only. Use credentials from one synthetic test account.
STRIPE_SECRET_KEY=sk_test_replace_with_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_endpoint_secret
STRIPE_ACCOUNT_ID=acct_replace_with_test_account_id
STRIPE_SUCCESS_URL=http://localhost:3000/booking/return
STRIPE_CANCEL_URL=http://localhost:3000/booking/cancel

# Milestone 14: canonical origin and independent 32-byte random secret (64 hex chars).
# Keep ACCESS_SECRET stable for active login flows/rate counters; never reuse Stripe secrets.
APP_ORIGIN=http://localhost:3000
ACCESS_SECRET=replace_with_64_random_hex_characters
# Choose a test OIDC provider enforcing fresh MFA, preferably passkeys/security keys.
# The ACR must be the exact documented MFA assurance value emitted by that provider.
ADMIN_OIDC_ISSUER=https://identity.example.test
ADMIN_OIDC_CLIENT_ID=replace_with_test_client_id
ADMIN_OIDC_CLIENT_SECRET=replace_with_test_client_secret
ADMIN_OIDC_MFA_ACR=replace_with_verified_mfa_acr
