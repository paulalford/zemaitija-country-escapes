# Local development only. Copy to .env.local; change every password before reuse.
POSTGRES_USER=zemaitija_bootstrap
POSTGRES_PASSWORD=change-bootstrap-local
POSTGRES_DB=zemaitija_dev
APP_DB_USER=zemaitija_app
APP_DB_PASSWORD=change-app-local
MIGRATION_DB_USER=zemaitija_migrator
MIGRATION_DB_PASSWORD=change-migration-local
DATABASE_URL=postgresql://zemaitija_app:change-app-local@127.0.0.1:5432/zemaitija_dev
MIGRATION_DATABASE_URL=postgresql://zemaitija_migrator:change-migration-local@127.0.0.1:5432/zemaitija_dev
