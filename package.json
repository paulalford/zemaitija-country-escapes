{
  "name": "zemaitija-country-escapes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests drizzle.config.ts next.config.ts vitest.config.mts postcss.config.mjs eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed:dev": "node scripts/seed-reference.mjs",
    "admin:provision:dev": "node --experimental-strip-types scripts/provision-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "next": "16.4.2",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
